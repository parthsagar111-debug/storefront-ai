GEMINI_API_KEY=
# free tier (see README "Models and free-tier limits"); after billing: gemini-3.8-flash / gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# random string
IP_HASH_SALT=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# e.g. https://storefront-ai.vercel.app
NEXT_PUBLIC_APP_URL=
# 1 = primary fails (shows fallback), 2 = both fail (shows retry)
FORCE_AI_FAIL=0
# local only, used by scripts/migrate.mjs to apply supabase/migrations (never needed on Vercel)
SUPABASE_DB_URL=
